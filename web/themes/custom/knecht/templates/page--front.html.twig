{#
/**
 * @file
 * Front page of the Knecht test-drupal10 e2e fixture.
 *
 * Mirrors the demo page of the other Knecht fixtures (see test-php), built
 * with the Knecht Styleguide Kit that is attached via the knecht/global
 * library. Variables prefixed with knecht_ are set in knecht.theme.
 */
#}
<main class="kit-container kit-stack">

  <span class="kit-badge kit-mb-4">drupal10-test-e2e</span>

  <h1>Drupal 10 Fixture <span class="kit-accent-text">Knecht.works</span></h1>

  <p class="kit-muted">
    A small demo page, built with the Knecht Styleguide Kit. Served from
    <code class="kit-code">{{ knecht_host }}</code> at {{ knecht_time }}.
  </p>

  <div class="kit-stack">
    <a class="kit-button kit-button--solid" href="https://knecht.works">Go to knecht.works</a>
    <button class="kit-button" data-kit-toast="Up and running! 🚀">Show toast</button>
    <a class="kit-button kit-button--ghost" href="{{ knecht_repo_url }}">Go to Repo</a>
  </div>

  <section class="kit-card kit-stack kit-mt-8">
    <dl class="kit-dl">
      {% for label, value in knecht_env %}
        <div class="kit-dl-row">
          <dt>{{ label }}</dt>
          <dd>{{ value }}</dd>
        </div>
      {% endfor %}
      <div class="kit-dl-row">
        <dt>Vite bundle</dt>
        <dd data-vite-status="pending">not loaded</dd>
      </div>
    </dl>
  </section>

  <p class="kit-muted">
    <a href="{{ knecht_login_url }}">admin login</a>
  </p>

</main>
